{% extends 'base.html.twig' %}

{% block title %}Gestión de Citas - Plataforma Automotriz{% endblock %}

{% block body %}
<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>{% if is_granted('ROLE_ADMIN') %}Gestión de Citas{% else %}Mis Citas{% endif %}</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_cita_new') }}" class="btn btn-primary">➕ Nueva Cita</a>
        {% endif %}
    </div>

    <div class="glass-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Cliente</th>
                        <th>Vehículo</th>
                        <th>Servicio</th>
                        <th>Estado</th>
                        <th>Fecha Deseada</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for citum in citas %}
                    <tr>
                        <td>#{{ citum.id }}</td>
                        <td>
                            {% if citum.clienteNombre %}
                                {{ citum.clienteNombre }}
                                <small class="d-block text-muted" style="font-size:0.75rem;">{{ citum.telefono }}</small>
                            {% elseif citum.cliente %}
                                {{ citum.cliente.email }}
                            {% else %}
                                <span class="text-muted">N/A</span>
                            {% endif %}
                        </td>
                        <td>{{ citum.vehiculo ? citum.vehiculo.matricula : 'N/A' }}</td>
                        <td>{{ citum.servicio ? citum.servicio.nombre : 'N/A' }}</td>
                        <td>
                            {% set badge_color = 'secondary' %}
                            {% if citum.estado == 'Pendiente' %}{% set badge_color = 'warning' %}
                            {% elseif citum.estado == 'En proceso' %}{% set badge_color = 'info' %}
                            {% elseif citum.estado == 'Finalizada' %}{% set badge_color = 'success' %}
                            {% elseif citum.estado == 'Cancelada' %}{% set badge_color = 'danger' %}
                            {% endif %}
                            <span class="badge bg-{{ badge_color }}">{{ citum.estado }}</span>
                        </td>
                        <td>{{ citum.fechaDeseada ? citum.fechaDeseada|date('d/m/Y H:i') : '' }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_cita_show', {'id': citum.id}) }}" class="btn btn-sm btn-outline-info">Ver</a>
                            <a href="{{ path('app_cita_edit', {'id': citum.id}) }}" class="btn btn-sm btn-outline-warning">Editar</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No hay citas registradas.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
