{% extends 'base.html.twig' %}

{% block title %}Inventario de Piezas - Plataforma Automotriz{% endblock %}

{% block body %}
<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Inventario de Piezas</h1>
        <a href="{{ path('app_pieza_new') }}" class="btn btn-primary">➕ Nueva Pieza</a>
    </div>

    <div class="glass-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Referencia</th>
                        <th>Nombre</th>
                        <th>Precio Unidad</th>
                        <th>Stock</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for pieza in piezas %}
                    <tr>
                        <td>{{ pieza.id }}</td>
                        <td><span class="badge bg-secondary">{{ pieza.referencia }}</span></td>
                        <td>{{ pieza.nombre }}</td>
                        <td>{{ pieza.precioUnidad|number_format(2, ',', '.') }} €</td>
                        <td>
                            {% if pieza.stock < 5 %}
                                <span class="badge bg-danger">{{ pieza.stock }} (Bajo)</span>
                            {% else %}
                                <span class="badge bg-success">{{ pieza.stock }}</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_pieza_show', {'id': pieza.id}) }}" class="btn btn-sm btn-outline-info">Ver</a>
                            <a href="{{ path('app_pieza_edit', {'id': pieza.id}) }}" class="btn btn-sm btn-outline-warning">Editar</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No hay piezas registradas en el inventario.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
