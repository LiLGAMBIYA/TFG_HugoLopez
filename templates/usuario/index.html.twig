{% extends 'base.html.twig' %}

{% block title %}Gestión de Usuarios - JM Motor{% endblock %}

{% block body %}
<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestión de <span style="color: var(--accent-blue);">Usuarios</span></h1>
        <a href="{{ path('app_usuario_new') }}" class="btn btn-primary">➕ Nuevo Usuario</a>
    </div>

    <div class="glass-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for usuario in usuarios %}
                    <tr>
                        <td>#{{ usuario.id }}</td>
                        <td class="fw-medium">{{ usuario.email }}</td>
                        <td>
                            {% for role in usuario.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-danger">ADMIN</span>
                                {% elseif role == 'ROLE_USER' %}
                                    <span class="badge bg-primary">USER</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ role }}</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a href="{{ path('app_usuario_show', {'id': usuario.id}) }}" class="btn btn-sm btn-outline-info">Ver</a>
                                <a href="{{ path('app_usuario_edit', {'id': usuario.id}) }}" class="btn btn-sm btn-outline-warning">Editar</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No hay usuarios registrados.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
