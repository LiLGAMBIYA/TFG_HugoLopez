{% extends 'base.html.twig' %}

{% block title %}Facturas - Plataforma Automotriz{% endblock %}

{% block body %}
<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Facturas Emitidas</h1>
        <a href="{{ path('app_factura_new') }}" class="btn btn-primary">➕ Generar Factura</a>
    </div>

    <div class="glass-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Nº Factura</th>
                        <th>Cita Asociada</th>
                        <th>Fecha de Emisión</th>
                        <th>Base Imponible</th>
                        <th>IVA</th>
                        <th>Total</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for factura in facturas %}
                    <tr>
                        <td><span class="badge bg-secondary">{{ factura.numeroFactura }}</span></td>
                        <td>{{ factura.cita ? '#' ~ factura.cita.id : 'N/A' }}</td>
                        <td>{{ factura.fechaEmision ? factura.fechaEmision|date('d/m/Y') : '' }}</td>
                        <td>{{ factura.baseImponible|number_format(2, ',', '.') }} €</td>
                        <td>{{ factura.iva|number_format(2, ',', '.') }} %</td>
                        <td class="fw-bold text-success">{{ factura.total|number_format(2, ',', '.') }} €</td>
                        <td class="text-end">
                            <a href="{{ path('app_factura_show', {'id': factura.id}) }}" class="btn btn-sm btn-outline-info">Ver / Imprimir</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No hay facturas emitidas.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
