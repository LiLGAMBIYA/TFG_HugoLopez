{% extends 'base.html.twig' %}

{% block title %}Factura {{ factura.numeroFactura }} - JM Motor{% endblock %}

{% block body %}
<div class="animate-fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h1>Factura <span style="color: var(--accent-blue);">{{ factura.numeroFactura }}</span></h1>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-primary btn-sm"><i class="bi bi-printer me-1"></i>Imprimir</button>
            <a href="{{ path('app_factura_index') }}" class="btn btn-outline-primary btn-sm">← Volver</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="glass-card p-4">
                <h4 class="mb-4" style="color: var(--accent-orange);">🧾 Datos de la Factura</h4>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3" style="background: rgba(0,0,0,0.2); border-radius: 8px;">
                            <small style="color: var(--text-secondary);">Nº Factura</small>
                            <p class="mb-0 fw-bold mt-1"><span class="badge bg-secondary fs-6">{{ factura.numeroFactura }}</span></p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3" style="background: rgba(0,0,0,0.2); border-radius: 8px;">
                            <small style="color: var(--text-secondary);">Cita Asociada</small>
                            <p class="mb-0 fw-bold mt-1">{{ factura.cita ? '#' ~ factura.cita.id : 'N/A' }}</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3" style="background: rgba(0,0,0,0.2); border-radius: 8px;">
                            <small style="color: var(--text-secondary);">Fecha de Emisión</small>
                            <p class="mb-0 fw-bold mt-1">{{ factura.fechaEmision ? factura.fechaEmision|date('d/m/Y') : 'N/A' }}</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3" style="background: rgba(0,0,0,0.2); border-radius: 8px;">
                            <small style="color: var(--text-secondary);">Base Imponible</small>
                            <p class="mb-0 fw-bold mt-1">{{ factura.baseImponible|number_format(2, ',', '.') }} €</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3" style="background: rgba(0,0,0,0.2); border-radius: 8px;">
                            <small style="color: var(--text-secondary);">IVA</small>
                            <p class="mb-0 fw-bold mt-1">{{ factura.iva|number_format(2, ',', '.') }} %</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3" style="background: rgba(0,0,0,0.2); border-radius: 8px; border: 1px solid rgba(34,197,94,.3);">
                            <small style="color: var(--text-secondary);">Total</small>
                            <p class="mb-0 fw-bold mt-1 fs-4" style="color: #22c55e;">{{ factura.total|number_format(2, ',', '.') }} €</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-card p-4">
                <h6 class="mb-3 text-muted">Acciones</h6>
                <div class="d-grid gap-2">
                    <a href="{{ path('app_factura_edit', {'id': factura.id}) }}" class="btn btn-outline-warning btn-sm">✏️ Editar Factura</a>
                    {{ include('factura/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
