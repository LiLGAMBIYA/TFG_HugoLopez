{% extends 'base.html.twig' %}

{% block title %}Gestión de Vehículos - Plataforma Automotriz{% endblock %}

{% block body %}
<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestión de Vehículos</h1>
        <a href="{{ path('app_vehiculo_new') }}" class="btn btn-primary">➕ Nuevo Vehículo</a>
    </div>

    <div class="glass-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Matrícula</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>VIN</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for vehiculo in vehiculos %}
                    <tr>
                        <td>{{ vehiculo.id }}</td>
                        <td><span class="badge bg-secondary">{{ vehiculo.matricula }}</span></td>
                        <td>{{ vehiculo.marca }}</td>
                        <td>{{ vehiculo.modelo }}</td>
                        <td>{{ vehiculo.vin }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_vehiculo_show', {'id': vehiculo.id}) }}" class="btn btn-sm btn-outline-info">Ver</a>
                            <a href="{{ path('app_vehiculo_edit', {'id': vehiculo.id}) }}" class="btn btn-sm btn-outline-warning">Editar</a>
                            <form method="post" action="{{ path('app_vehiculo_delete', {'id': vehiculo.id}) }}" class="d-inline" onsubmit="return confirm('¿Seguro que quieres eliminar este vehículo? Las citas asociadas se conservarán sin vehículo.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vehiculo.id) }}">
                                <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No hay vehículos registrados.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
