{% extends 'base.html.twig' %}

{% block title %}Vehículo {{ vehiculo.matricula }} - JM Motor{% endblock %}

{% block body %}
<div class="animate-fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h1>Vehículo <span style="color: var(--accent-blue);">{{ vehiculo.matricula }}</span></h1>
        <a href="{{ path('app_vehiculo_index') }}" class="btn btn-outline-primary">← Volver al listado</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="glass-card p-4">
                <h4 class="mb-4" style="color: var(--accent-orange);">🚗 Datos del Vehículo</h4>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3" style="background: rgba(0,0,0,0.2); border-radius: 8px;">
                            <small style="color: var(--text-secondary);">Matrícula</small>
                            <p class="mb-0 fw-bold mt-1"><span class="badge bg-secondary fs-6">{{ vehiculo.matricula }}</span></p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3" style="background: rgba(0,0,0,0.2); border-radius: 8px;">
                            <small style="color: var(--text-secondary);">Marca</small>
                            <p class="mb-0 fw-bold mt-1">{{ vehiculo.marca }}</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3" style="background: rgba(0,0,0,0.2); border-radius: 8px;">
                            <small style="color: var(--text-secondary);">Modelo</small>
                            <p class="mb-0 fw-bold mt-1">{{ vehiculo.modelo }}</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3" style="background: rgba(0,0,0,0.2); border-radius: 8px;">
                            <small style="color: var(--text-secondary);">VIN</small>
                            <p class="mb-0 fw-bold mt-1" style="font-family: monospace; font-size: .85rem;">{{ vehiculo.vin }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-card p-4">
                <h6 class="mb-3 text-muted">Acciones</h6>
                <div class="d-grid gap-2">
                    <a href="{{ path('app_vehiculo_edit', {'id': vehiculo.id}) }}" class="btn btn-outline-warning btn-sm">✏️ Editar Vehículo</a>
                    {{ include('vehiculo/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
