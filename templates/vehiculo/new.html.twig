{% extends 'base.html.twig' %}

{% block title %}Nuevo Vehículo - JM Motor{% endblock %}

{% block body %}
<div class="row justify-content-center animate-fade-in mt-4">
    <div class="col-md-8">
        <div class="glass-card p-5" style="border-top: 4px solid var(--accent-blue);">
            <h1 class="mb-1">🚗 Nuevo <span style="color: var(--accent-blue);">Vehículo</span></h1>
            <p class="text-muted mb-4">Registra un nuevo vehículo en el sistema.</p>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                {{ form_errors(form) }}

                {% for child in form %}
                    <div class="mb-3">
                        {{ form_label(child) }}
                        {{ form_widget(child, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(child) }}
                    </div>
                {% endfor %}

                <div class="d-flex gap-3 mt-4">
                    <button class="btn btn-primary flex-grow-1">💾 Guardar Vehículo</button>
                    <a href="{{ path('app_vehiculo_index') }}" class="btn btn-outline-primary">Cancelar</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
