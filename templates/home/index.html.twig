{% extends 'base.html.twig' %}

{% block title %}Inicio - JM Motor Taller Mecánico{% endblock %}

{% block body %}
<div class="row mt-4 animate-fade-in">
    <div class="col-12">
        <!-- RF-01: Landing Page Banner -->
        <div class="glass-card text-center mb-5 p-5" style="background: linear-gradient(135deg, rgba(0,212,255,0.1) 0%, rgba(9,9,121,0.1) 100%); border-bottom: 3px solid var(--accent);">
            <h1 class="display-4 fw-bold mb-3">Tu Taller de Confianza, <br><span style="color: var(--accent);">Ahora Digital</span></h1>
            <p class="lead mb-4" style="color: var(--text-secondary);">
                Gestiona tus vehículos, consulta nuestros servicios y solicita citas de forma rápida y sencilla.
            </p>
            
            <div class="d-flex justify-content-center gap-3 mt-4">
                <a href="{{ path('app_home_reservar') }}" class="btn btn-primary btn-lg px-5 py-3 fw-bold" style="font-size: 1.1rem; box-shadow: 0 4px 15px rgba(255, 107, 0, 0.4);">Pedir Cita</a>
            </div>


        </div>

        {% if app.user %}
        <!-- Panel Privado Usuario/Admin -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="glass-card h-100 text-center p-4">
                    <div style="font-size: 3rem; margin-bottom: 1rem;">🚗</div>
                    <h3>Mis Vehículos</h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem;">Registra y administra los vehículos asociados a tu cuenta para solicitar servicios.</p>
                    <a href="{{ path('app_vehiculo_index') }}" class="btn btn-outline-primary mt-3">Ver Vehículos</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card h-100 text-center p-4">
                    <div style="font-size: 3rem; margin-bottom: 1rem;">📅</div>
                    <h3>Mis Citas</h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem;">Agenda una nueva cita para revisión, reparación o mantenimiento de tu vehículo.</p>
                    <a href="{{ path('app_cita_index') }}" class="btn btn-outline-primary mt-3">Gestionar Citas</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card h-100 text-center p-4">
                    {% if is_granted('ROLE_ADMIN') %}
                        <div style="font-size: 3rem; margin-bottom: 1rem;">🧾</div>
                        <h3>Facturas</h3>
                        <p style="color: var(--text-secondary); font-size: 0.9rem;">Consulta y gestiona el historial de facturas de los servicios finalizados.</p>
                        <a href="{{ path('app_factura_index') }}" class="btn btn-outline-primary mt-3">Ver Facturas</a>
                    {% else %}
                        <div style="font-size: 3rem; margin-bottom: 1rem;">🛠️</div>
                        <h3>Nueva Cita</h3>
                        <p style="color: var(--text-secondary); font-size: 0.9rem;">Solicita una revisión, reparación o mantenimiento para tu vehículo.</p>
                        <a href="{{ path('app_home_reservar') }}" class="btn btn-outline-primary mt-3">Pedir Cita</a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}

        <!-- RF-02: Catálogo de Servicios -->
        <h2 class="mb-4 text-center">Nuestros <span style="color: var(--accent);">Servicios</span></h2>
        <div class="row g-4 mb-5">
            {% if servicios is defined and servicios|length > 0 %}
                {% for servicio in servicios %}
                    <div class="col-md-6 col-lg-4">
                        <div class="glass-card h-100">
                            <h4 class="text-white">{{ servicio.nombre }}</h4>
                            <p class="text-muted">{{ servicio.descripcion ?: 'Servicio profesional de mantenimiento y reparación para su vehículo.' }}</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="badge bg-primary px-3 py-2 fs-6">{{ servicio.precio }} €</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-md-6 col-lg-4">
                    <div class="glass-card h-100">
                        <h4 class="text-white">Mecánica general</h4>
                        <p class="text-muted">Diagnóstico y reparación de averías mecánicas habituales del vehículo.</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge bg-primary px-3 py-2 fs-6">Consultar</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="glass-card h-100">
                        <h4 class="text-white">Mantenimiento</h4>
                        <p class="text-muted">Cambio de aceite, filtros, revisiones periódicas y puesta a punto.</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge bg-primary px-3 py-2 fs-6">Consultar</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="glass-card h-100">
                        <h4 class="text-white">Neumáticos</h4>
                        <p class="text-muted">Revisión, sustitución y equilibrado de neumáticos para circular con seguridad.</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge bg-primary px-3 py-2 fs-6">Consultar</span>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <!-- RF-03: Localización y Contacto -->
        <div class="glass-card p-4 mb-5">
            <h2 class="mb-4 text-center">Ubicación y <span style="color: var(--accent);">Contacto</span></h2>
            <div class="row">
                <div class="col-md-6 mb-4 mb-md-0">
                    <div class="rounded overflow-hidden h-100 position-relative" style="min-height: 300px;">
                        <div class="position-absolute top-0 start-0 end-0 p-3" style="z-index: 2; background: linear-gradient(180deg, rgba(0,0,0,.78), rgba(0,0,0,.15));">
                            <strong class="d-block text-white">Cam. de Purchil, 1, Ronda, 18004 Granada</strong>
                            <a href="https://www.google.com/maps/search/?api=1&query=JM+Motor+Taller+Mec%C3%A1nico+Cam.+de+Purchil+1+Ronda+18004+Granada" target="_blank" rel="noopener" class="btn btn-sm btn-primary mt-2">
                                Abrir en Google Maps
                            </a>
                        </div>
                        <iframe 
                            src="https://www.google.com/maps?q=JM%20Motor%20Taller%20Mec%C3%A1nico%2C%20Cam.%20de%20Purchil%2C%201%2C%20Ronda%2C%2018004%20Granada&z=16&output=embed" 
                            width="100%" 
                            height="100%" 
                            style="border:0; min-height: 300px;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
                <div class="col-md-6 d-flex flex-column justify-content-center px-md-5">
                    <h4 class="text-white mb-3">JM Motor Taller Mecánico</h4>
                    
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">📍</div>
                        <div>
                            <strong class="d-block text-white">Dirección</strong>
                            <span class="text-muted">Cam. de Purchil, 1, Ronda, 18004 Granada</span>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">📞</div>
                        <div>
                            <strong class="d-block text-white">Teléfono</strong>
                            <span class="text-muted">664 30 50 28</span>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">✉️</div>
                        <div>
                            <strong class="d-block text-white">Correo electrónico</strong>
                            <a class="text-muted text-decoration-none" href="mailto:jmmotor@taller.es">jmmotor@taller.es</a>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">🕒</div>
                        <div>
                            <strong class="d-block text-white">Horario de Apertura</strong>
                            <span class="text-muted d-block">Mañanas: 09:00 - 14:00</span>
                            <span class="text-muted d-block">Tardes: 16:30 - 20:00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
