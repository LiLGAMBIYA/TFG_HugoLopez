{% extends 'base.html.twig' %}

{% block title %}Catálogo de Servicios - JM Motor{% endblock %}

{% block body %}
<div class="row animate-fade-in mt-4">
    <div class="col-12">
        <div class="glass-card mb-5 p-5" style="border-top: 4px solid var(--accent);">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="display-6 fw-bold mb-0">Catálogo de <span style="color: var(--accent);">Servicios</span></h1>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_servicio_new') }}" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Crear Nuevo Servicio</a>
                {% endif %}
            </div>
            
            <p class="lead text-muted mb-5">Consulte nuestra lista de servicios y tarifas base. Si no encuentra lo que busca, no dude en contactarnos.</p>

            <div class="row g-4">
            {% for servicio in servicios %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 bg-dark text-white shadow-sm border-0" style="transition: transform 0.3s; border-left: 4px solid var(--primary) !important;">
                        <div class="card-body p-4 d-flex flex-column">
                            <h4 class="card-title fw-bold">{{ servicio.nombre }}</h4>
                            <p class="card-text text-muted flex-grow-1 mt-2">{{ servicio.descripcion }}</p>
                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary">
                                <span class="fs-4 fw-bold text-white">{{ servicio.precio }} <small class="fs-6 text-muted">€</small></span>
                                
                                {% if is_granted('ROLE_ADMIN') %}
                                <div class="btn-group">
                                    <a href="{{ path('app_servicio_show', {'id': servicio.id}) }}" class="btn btn-sm btn-outline-info">Ver</a>
                                    <a href="{{ path('app_servicio_edit', {'id': servicio.id}) }}" class="btn btn-sm btn-outline-warning">Editar</a>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center text-muted py-5">
                    <div style="font-size: 3rem; margin-bottom: 1rem;">🔧</div>
                    <p class="fs-5">No hay servicios configurados actualmente.</p>
                </div>
            {% endfor %}
            </div>
            
            {% if not is_granted('ROLE_ADMIN') %}
            <div class="text-center mt-5 pt-4">
                <a href="{{ path('app_home_reservar') }}" class="btn btn-primary btn-lg px-5 py-3 fw-bold" style="box-shadow: 0 4px 15px rgba(255, 107, 0, 0.4);">Reservar Cita Ahora</a>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    .card:hover {
        transform: translateY(-5px);
    }
</style>
{% endblock %}
