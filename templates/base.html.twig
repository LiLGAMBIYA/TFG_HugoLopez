<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="JM Motor Taller Mecánico - Solicita cita, consulta servicios y localízanos en Granada. Especialistas en Audi y Volkswagen.">
    <title>{% block title %}JM Motor - Taller Mecánico Granada{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚙️</text></svg>">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% endblock %}
    {% block javascripts %}{% endblock %}
</head>
<body>

<div class="app-wrapper {% if not is_granted('ROLE_ADMIN') %}user-layout{% endif %}">

    {% if is_granted('ROLE_ADMIN') %}
        {# ============================================================ #}
        {# SIDEBAR ADMIN (Desktop) + Overlay hamburger (Mobile)         #}
        {# ============================================================ #}

        {# Botón hamburguesa solo visible en móvil cuando es admin #}
        <button class="admin-hamburger d-lg-none" id="adminMenuToggle" aria-label="Abrir menú">
            <i class="bi bi-list"></i>
        </button>

        {# Overlay oscuro detrás del sidebar en móvil #}
        <div class="sidebar-overlay d-lg-none" id="sidebarOverlay"></div>

        <nav class="sidebar" id="adminSidebar">
            <div class="sidebar-header">
                <a class="sidebar-brand" href="{{ path('app_home') }}">JM<span>Motor</span></a>
                <span class="badge bg-danger mt-1">ADMIN</span>
                <button class="sidebar-close d-lg-none" id="sidebarClose" aria-label="Cerrar menú">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <nav class="sidebar-nav">
                <div class="sidebar-section-label">Principal</div>
                <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_home' ? 'active' }}" href="{{ path('app_home') }}">
                    <i class="bi bi-house-fill"></i><span>Inicio</span>
                </a>

                <div class="sidebar-section-label mt-3">Gestión</div>
                <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_cita' ? 'active' }}" href="{{ path('app_cita_index') }}">
                    <i class="bi bi-calendar-check-fill"></i><span>Citas</span>
                </a>
                <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_vehiculo' ? 'active' }}" href="{{ path('app_vehiculo_index') }}">
                    <i class="bi bi-car-front-fill"></i><span>Vehículos</span>
                </a>
                <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_factura' ? 'active' }}" href="{{ path('app_factura_index') }}">
                    <i class="bi bi-receipt"></i><span>Facturación</span>
                </a>

                <div class="sidebar-section-label mt-3">Catálogo</div>
                <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_servicio' ? 'active' }}" href="{{ path('app_servicio_index') }}">
                    <i class="bi bi-list-check"></i><span>Servicios</span>
                </a>
                <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_pieza' ? 'active' }}" href="{{ path('app_pieza_index') }}">
                    <i class="bi bi-gear-fill"></i><span>Piezas</span>
                </a>

                <div class="sidebar-section-label mt-3">Administración</div>
                <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_usuario' ? 'active' }}" href="{{ path('app_usuario_index') }}">
                    <i class="bi bi-people-fill"></i><span>Usuarios</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="sidebar-avatar"><i class="bi bi-person-fill"></i></div>
                    <div class="sidebar-user-info">
                        <span class="sidebar-user-name">{{ app.user.userIdentifier }}</span>
                        <span class="sidebar-user-role">Administrador</span>
                    </div>
                </div>
                <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm w-100 mt-3">
                    <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
                </a>
            </div>
        </nav>

    {% else %}
        {# ============================================================ #}
        {# NAVBAR PÚBLICA con menú hamburguesa Bootstrap                #}
        {# ============================================================ #}
        <nav class="navbar navbar-expand-lg top-navbar w-100 position-fixed top-0 z-3">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">JM<span>Motor</span></a>

                {# Botón hamburguesa Bootstrap nativo #}
                <button class="navbar-toggler custom-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-4 text-white"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mt-2 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') == 'app_home' ? 'active' }}" href="{{ path('app_home') }}">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_servicio' ? 'active' }}" href="{{ path('app_servicio_index') }}">Precios / Servicios</a>
                        </li>
                        {% if is_granted('ROLE_USER') %}
                            <li class="nav-item">
                                <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_vehiculo' ? 'active' }}" href="{{ path('app_vehiculo_index') }}">Mis Vehículos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_cita' ? 'active' }}" href="{{ path('app_cita_index') }}">Mis Citas</a>
                            </li>
                        {% endif %}
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2 mt-2 mt-lg-0">
                        <li class="nav-item">
                            <a href="{{ path('app_home_reservar') }}" class="btn btn-cita btn-sm fw-bold">
                                <i class="bi bi-calendar-plus me-1"></i>Pedir Cita
                            </a>
                        </li>
                        {% if app.user %}
                            <li class="nav-item">
                                <span class="text-muted small d-none d-lg-inline">Hola, <span class="text-white">{{ app.user.userIdentifier }}</span></span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right me-1"></i>Salir
                                </a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" href="{{ path('app_login') }}">Entrar</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm" href="{{ path('app_register') }}">Registrarse</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
    {% endif %}

    {# ============================================================ #}
    {# CONTENIDO PRINCIPAL                                          #}
    {# ============================================================ #}
    <div class="page-wrapper {% if is_granted('ROLE_ADMIN') %}with-sidebar{% endif %}">
        <main class="main-content {% if not is_granted('ROLE_ADMIN') %}pt-navbar{% endif %}">
            <div class="container-fluid px-3 px-md-4">

                {# Flash messages globales #}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mt-3" role="alert">
                            <i class="bi bi-{{ type == 'success' ? 'check-circle' : (type == 'danger' or type == 'error' ? 'exclamation-triangle' : 'info-circle') }}-fill me-2"></i>
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </div>
        </main>

        {# ============================================================ #}
        {# FOOTER (solo visible para usuarios no-admin)                 #}
        {# ============================================================ #}
        {% if not is_granted('ROLE_ADMIN') %}
        <footer class="site-footer">
            <div class="footer-top">
                <div class="container">
                    <div class="row g-4">

                        {# Columna Marca #}
                        <div class="col-12 col-md-4">
                            <div class="footer-brand">JM<span>Motor</span></div>
                            <p class="footer-tagline">Especialistas en Audi &amp; Volkswagen.<br>Tu taller de confianza en Granada.</p>
                            <div class="footer-social">
                                <a href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook" class="social-icon">
                                    <i class="bi bi-facebook"></i>
                                </a>
                                <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram" class="social-icon">
                                    <i class="bi bi-instagram"></i>
                                </a>
                                <a href="https://wa.me/34664305028" target="_blank" rel="noopener" aria-label="WhatsApp" class="social-icon whatsapp">
                                    <i class="bi bi-whatsapp"></i>
                                </a>
                                <a href="https://www.google.com/maps/search/?api=1&query=Cam.+de+Purchil+1+Granada" target="_blank" rel="noopener" aria-label="Google Maps" class="social-icon maps">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </a>
                            </div>
                        </div>

                        {# Columna Servicios #}
                        <div class="col-6 col-md-2">
                            <h6 class="footer-heading">Servicios</h6>
                            <ul class="footer-links">
                                <li><a href="{{ path('app_servicio_index') }}">Mecánica General</a></li>
                                <li><a href="{{ path('app_servicio_index') }}">Mantenimiento</a></li>
                                <li><a href="{{ path('app_servicio_index') }}">Diagnóstico</a></li>
                                <li><a href="{{ path('app_servicio_index') }}">Neumáticos</a></li>
                                <li><a href="{{ path('app_home_reservar') }}">Pedir Cita</a></li>
                            </ul>
                        </div>

                        {# Columna Empresa #}
                        <div class="col-6 col-md-2">
                            <h6 class="footer-heading">Empresa</h6>
                            <ul class="footer-links">
                                <li><a href="{{ path('app_home') }}">Inicio</a></li>
                                <li><a href="{{ path('app_servicio_index') }}">Precios</a></li>
                                <li><a href="{{ path('app_login') }}">Área Clientes</a></li>
                                <li><a href="{{ path('app_register') }}">Registrarse</a></li>
                            </ul>
                        </div>

                        {# Columna Contacto #}
                        <div class="col-12 col-md-4">
                            <h6 class="footer-heading">Contacto</h6>
                            <ul class="footer-contact">
                                <li>
                                    <i class="bi bi-geo-alt-fill"></i>
                                    <span>Cam. de Purchil, 1<br>Ronda, 18004 Granada</span>
                                </li>
                                <li>
                                    <i class="bi bi-telephone-fill"></i>
                                    <a href="tel:+34664305028">664 30 50 28</a>
                                </li>
                                <li>
                                    <i class="bi bi-clock-fill"></i>
                                    <span>Lun–Vie: 09:00–14:00 / 16:30–20:00</span>
                                </li>
                                <li>
                                    <i class="bi bi-envelope-fill"></i>
                                    <a href="mailto:jmmotor@taller.es">jmmotor@taller.es</a>
                                </li>
                            </ul>
                        </div>

                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="container">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                        <span>&copy; {{ "now"|date("Y") }} JM Motor Taller Mecánico · Granada</span>
                        <span class="footer-credits">
                            Desarrollado como TFG &nbsp;·&nbsp;
                            <a href="{{ path('app_login') }}">Acceso Admin</a>
                        </span>
                    </div>
                </div>
            </div>
        </footer>
        {% endif %}
    </div>{# end page-wrapper #}

</div>{# end app-wrapper #}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
<script>
// ─── Admin Sidebar Mobile Toggle ──────────────────────────────────────────────
(function () {
    const toggle   = document.getElementById('adminMenuToggle');
    const sidebar  = document.getElementById('adminSidebar');
    const overlay  = document.getElementById('sidebarOverlay');
    const closeBtn = document.getElementById('sidebarClose');

    function openSidebar()  { sidebar?.classList.add('open');  overlay?.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeSidebar() { sidebar?.classList.remove('open'); overlay?.classList.remove('open'); document.body.style.overflow = ''; }

    toggle?.addEventListener('click', openSidebar);
    closeBtn?.addEventListener('click', closeSidebar);
    overlay?.addEventListener('click', closeSidebar);

    // Cerrar con Escape
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSidebar(); });
})();
</script>
</body>
</html>
